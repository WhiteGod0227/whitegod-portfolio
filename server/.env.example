# Server Configuration
PORT=5000
NODE_ENV=development

# Allowed Origins (CORS) - Comma-separated
CLIENT_ORIGIN=*

# MongoDB Database URI (Leave empty to use local auto-fallback JSON storage)
MONGO_URI=

# Nodemailer / Email Alert Credentials (Optional)
# If left blank, scrolls are saved to database/local file without crashing
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
EMAIL_USER=
EMAIL_PASS=
NOTIFICATION_EMAIL=ayush.singh.10293@gmail.com
